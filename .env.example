# =====================================================================
# Knotopian Institute of Technology (KIT) – Real-Time Voice Assistant
# Environment Variables Reference
# =====================================================================

NODE_ENV=production

# --- Groq AI Configuration ---
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_STT_FALLBACK_MODEL=whisper-large-v3

# --- Live College API Configuration ---
COLLEGE_API_BASE_URL=https://ht.knowvally.com
COLLEGE_API_CLIENT_ID=your_api_client_id_if_required
COLLEGE_API_CLIENT_SECRET=your_api_client_secret_if_required
COLLEGE_PARTICIPANT_KEY=kit_live_25f00b7a7c9db51a3f26c2519171043d7ee9025a
COLLEGE_API_TIMEOUT_SECONDS=10
COLLEGE_TIMEZONE=Asia/Kolkata

# --- Security & Sessions ---
SESSION_SECRET=a_securely_generated_random_secret
SESSION_SECRET_KEY=a_securely_generated_random_secret
SESSION_COOKIE_NAME=quirri_session

# --- Database Configuration (PostgreSQL with SQLite Fallback) ---
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/kit_college

# --- Network & Frontend ---
GROK_BASE_URL=https://api.groq.com/openai/v1
GROK_MODEL=openai/gpt-oss-120b
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
KNOWLEDGE_DOCS_DIR=../data/documents
BACKEND_INTERNAL_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_COLLEGE_NAME=Knotopian Institute of Technology
